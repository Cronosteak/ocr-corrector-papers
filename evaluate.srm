#!/bin/bash
#SBATCH --job-name=ocr-postprocess
#SBATCH --output=logs/postprocess_%j.output
#SBATCH --error=logs/postprocess_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --partition=gpu
#SBATCH --account=prosei
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G


# ── Adjust these paths ────────────────────────────────────────────────────────
REPO_PATH="$HOME/ocr-corrector-papers"
SIF_PATH="$REPO_PATH/singularity/ocr-corrector.sif"
# ─────────────────────────────────────────────────────────────────────────────

export CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES

mkdir -p "$REPO_PATH/logs"

echo "========================================"
echo " OCR Corrector — Postprocess Job"
echo "========================================"
echo "SLURM_JOBID         : $SLURM_JOBID"
echo "SLURM_JOB_NODELIST  : $SLURM_JOB_NODELIST"
echo "CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"
echo "REPO                : $REPO_PATH"
echo "SIF                 : $SIF_PATH"
echo "Start time          : $(date)"
echo "========================================"

singularity exec --nv \
    -B "$REPO_PATH":/app \
    "$SIF_PATH" \
    python -m src.model.postprocess \
        --model models/ocr-corrector \
        --data  data/pairs/synthetic_test.json

EXIT_CODE=$?
echo "========================================"
echo "End time  : $(date)"
echo "Exit code : $EXIT_CODE"
echo "========================================"
