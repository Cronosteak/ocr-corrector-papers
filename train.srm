#!/bin/bash
#SBATCH --job-name=ocr-corrector
#SBATCH --output=logs/train_%j.output
#SBATCH --error=logs/train_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --partition=gpu
#SBATCH --account=prosei
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G


# ── Adjust these paths ────────────────────────────────────────────────────────
REPO_PATH="/share_beta/prosei/Breinner/ocr-corrector-papers"
SIF_PATH="$REPO_PATH/singularity/ocr-corrector.sif"
# ─────────────────────────────────────────────────────────────────────────────

export CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES

mkdir -p "$REPO_PATH/logs"
mkdir -p "$REPO_PATH/models/ocr-corrector"

echo "========================================"
echo " OCR Corrector — Training Job"
echo "========================================"
echo "SLURM_JOBID         : $SLURM_JOBID"
echo "SLURM_JOB_NODELIST  : $SLURM_JOB_NODELIST"
echo "CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"
echo "REPO                : $REPO_PATH"
echo "SIF                 : $SIF_PATH"
echo "Start time          : $(date)"
echo "========================================"

singularity run --nv \
    -B "$REPO_PATH":/app \
    "$SIF_PATH"

EXIT_CODE=$?
echo "========================================"
echo "End time  : $(date)"
echo "Exit code : $EXIT_CODE"
echo "========================================"
