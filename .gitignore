# Virtual environments
venv/
.venv/
env/
.env/

# Environment variables
.env
*.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Singularity images (too large for git)
singularity/
singularity/*.sif

# Raw data and PDFs (heavy, not versioned)
data/raw/
data/ocr/
data/ground_truth/

# Trained models (heavy binaries) — weights are published on Hugging Face
models/
*.pt
*.bin
*.safetensors

# Logs
logs/
*.log

# Paper sources (local only)
paper/

# Cluster scripts outside slurm_scripts/
*.sh
*.srm

# IDEs
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# Tesseract / pdf2image temporaries
*.tiff
*.png

# ── Exceptions: files the paper's availability appendix promises ──────────────
# Evaluation artifacts (light, ~4 MB)
!results/
!results/**/*.json
!results/**/*.png
# SLURM job scripts used to produce the paper results
!slurm_scripts/
!slurm_scripts/*.sh
!slurm_scripts/*.srm
